# Server configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database configuration
DATABASE_URL=sqlite:///./backend/restaurant.db

# Local LLM configuration (Ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TEMPERATURE=0.1

# Customer registration (name + phone collected by CHAT/VOICE via POST /api/customers).
# true  = bookings need a registered customer, only the owner can read/modify/cancel
# false = legacy behaviour (no registration, no ownership check)
REQUIRE_CUSTOMER_REGISTRATION=true
