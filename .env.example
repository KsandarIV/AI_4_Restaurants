# Unico .env di progetto: copia in `.env` e compila (mai commitare il .env).
# cp .env.example .env   (oppure: copy .env.example .env)

# ================= VOICE =================
VOICE_HOST=0.0.0.0
VOICE_PORT=8003
# URL base del BE (macchina separata in LAN, porta 8000). NON localhost, se il BE e' su un altro PC.
# Verifica tutto con:  python -m voicebot.doctor
BACKEND_BASE_URL=http://192.168.1.10:8000
BACKEND_TIMEOUT_S=15.0
BACKEND_CHAT_TIMEOUT_S=120.0
BACKEND_API_KEY=
BACKEND_CHAT_STREAM_PATH=/api/chat/stream

# --- Conversation (the voice bot behaves like the chat bot) ---
# Spoken language of the bot's own sentences and of STT: it | en
VOICE_LANGUAGE=it
# Mirror of the BE switch REQUIRE_CUSTOMER_REGISTRATION: ask name + phone before bookings.
REQUIRE_REGISTRATION=true
# v2 only: drive the running CHAT service (chat/api.py) instead of the BE directly. Empty = off.
CHAT_SERVICE_URL=
# Empty = built-in English agent prompt (voicebot/prompts.py).
LLM_SYSTEM_PROMPT=
LLM_MAX_HISTORY=12

# --- Audio ---
SAMPLE_RATE=16000
FRAME_MS=20

# --- VAD ---
# energy | webrtc
VAD_MODE=energy
VAD_ENERGY_THRESHOLD=500.0
VAD_SILENCE_MS=600
VAD_MIN_SPEECH_MS=250
VAD_MAX_SEGMENT_S=15.0

# --- STT ---
# faster-whisper | fake (fake = no recognition, for dry runs)
STT_BACKEND=faster-whisper
# tiny is fast but mangles digits and names; small is accurate (~1.5 s per 4 s of speech on CPU)
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# empty = follow VOICE_LANGUAGE
STT_LANGUAGE=
STT_TIMEOUT_S=30.0
# empty = built-in booking-context prompt that helps Whisper with digits
STT_INITIAL_PROMPT=

# --- TTS ---
# piper | fake (fake = beeps, for dry runs). Path is resolved from cwd, repo root or voice/.
TTS_BACKEND=piper
PIPER_MODEL_PATH=voice/models/it_IT-riccardo-x_low.onnx
PIPER_CONFIG_PATH=
TTS_SAMPLE_RATE=22050

# --- Pipeline ---
AUDIO_IN_QUEUE_MAX=200
TEXT_QUEUE_MAX=32
AUDIO_OUT_QUEUE_MAX=200
BARGE_IN_ENABLED=true
# speech must last this long while the bot talks to count as an interruption (filters clicks/echo)
BARGE_IN_MIN_MS=300
# load STT/TTS in the background at startup (otherwise at the first call)
PRELOAD_MODELS=true
WS_IDLE_TIMEOUT_S=60.0
LOG_LEVEL=INFO

# ================= BE (nomi reali da backend/config.py) =================
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:12b
# Puo' essere un elenco in ordine di preferenza (gemma4:12b,gemma4-coder): il BE usa il primo installato in Ollama
# che sappia usare gli strumenti (necessari per prenotare), e lo scrive nel log. Altrimenti prova i ripieghi:
# OLLAMA_FALLBACK_MODELS=gemma4-coder,llama3.2
# Quanto Ollama tiene il modello in memoria (il BE lo carica all'avvio, cosi' il primo cliente non aspetta).
# OLLAMA_KEEP_ALIVE=30m
# DATABASE_URL=sqlite:///backend/restaurant.db
# Registrazione clienti (nome+telefono via POST /api/customers). true = si prenota solo da clienti
# registrati e solo il proprietario vede/modifica/cancella; false = comportamento precedente.
# REQUIRE_CUSTOMER_REGISTRATION=true
# "Thinking" dei modelli che ragionano (es. gemma4). Vuoto = SPENTO (risposte molto piu' veloci).
# 'true' si attiva solo se il modello lo supporta (altrimenti viene ignorato).
# OLLAMA_REASONING=false
# Area staff del ristoratore (/api/staff). Vuota = disabilitata. Scegliere una chiave lunga e segreta.
# STAFF_API_KEY=
# Origini web ammesse dal BE ('*' = tutte, va bene in LAN). Es: http://192.168.1.20:5500,http://localhost:5500
# CORS_ORIGINS=*
# Giorni di chiusura settimanale (0=lunedi ... 6=domenica). Le chiusure straordinarie si inseriscono dall'area staff.
# CLOSED_WEEKDAYS=0
# Secondi massimi di attesa del modello prima di rispondere 503.
# OLLAMA_TIMEOUT_S=120
# Giorni di conservazione di nome e telefono (comando: python -m backend.maintenance purge).
# DATA_RETENTION_DAYS=90

# ================= CHAT (membro 2: completare dopo il pull) =================
# CHAT_HOST=0.0.0.0
# CHAT_PORT=8002
