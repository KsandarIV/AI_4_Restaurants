# --- Rete / Server ---
VOICE_HOST=0.0.0.0
VOICE_PORT=8003
# URL base del BE (macchina separata in LAN). Es: http://192.168.1.10:8001
BACKEND_BASE_URL=http://192.168.1.10:8001
BACKEND_TIMEOUT_S=15.0
BACKEND_API_KEY=
# Endpoint streaming LLM esposto dal BE (Ollama/locale). Es: /api/chat/stream (SSE chunk json {"token": "..."})
BACKEND_CHAT_STREAM_PATH=/api/chat/stream
BACKEND_HEALTH_PATH=/health

# --- Audio ---
SAMPLE_RATE=16000
FRAME_MS=20
# 1 = mono PCM16LE atteso su WebSocket (bytes). Il server risponde con PCM16LE 16kHz.
INPUT_WS_PATH=/ws/voice

# --- VAD ---
VAD_MODE=energy
# energy | webrtc | silero
VAD_ENERGY_THRESHOLD=500.0
VAD_SILENCE_MS=600
VAD_MIN_SPEECH_MS=250
VAD_MAX_SEGMENT_S=15.0

# --- STT ---
STT_BACKEND=faster-whisper
# faster-whisper | fake
STT_MODEL=tiny
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=it

# --- LLM Orchestrator ---
LLM_SYSTEM_PROMPT=Sei un assistente vocale di un ristorante. Rispondi in italiano, conciso, max 2 frasi per turno. Per prenotare chiedi data, ora, numero persone e nome.
LLM_MAX_HISTORY=12
LLM_TOKEN_TIMEOUT_S=30.0

# --- TTS ---
TTS_BACKEND=piper
# piper | fake
PIPER_MODEL_PATH=models/it_IT-riccardo-x_low.onnx
PIPER_CONFIG_PATH=
TTS_SAMPLE_RATE=22050

# --- Pipeline ---
AUDIO_IN_QUEUE_MAX=200
TEXT_QUEUE_MAX=32
AUDIO_OUT_QUEUE_MAX=200
BARGE_IN_ENABLED=true
LOG_LEVEL=INFO
